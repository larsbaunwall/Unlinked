{
  "name": "@larsbaunwall/unlinked",
  "version": "2.0.0",
  "mcpName": "io.github.larsbaunwall/unlinked",
  "description": "Your LinkedIn profile as JSON from the command line, and as an MCP server for AI assistants like Claude Desktop and GitHub Copilot.",
  "main": "dist/index.js",
  "bin": {
    "unlinked": "dist/index.js"
  },
  "files": [
    "dist",
    "logo.png"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "inspect": "mcp-inspector --web node --env-file-if-exists=.env dist/index.js --mcp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larsbaunwall/Unlinked.git"
  },
  "keywords": [
    "mcp",
    "linkedin",
    "model-context-protocol",
    "ai",
    "professional-profile"
  ],
  "author": "Lars Baunwall",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/larsbaunwall/unlinked/issues"
  },
  "homepage": "https://github.com/larsbaunwall/unlinked#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.9.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
